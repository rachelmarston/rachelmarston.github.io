@article{marston2025mixed,
  abbr              = {CommSci},
  title             = {A Mixed-Methods Needs Assessment of Frontline Communities: Insights for Engagement and Partnerships Between Communities and Intermediary Organizations},
  author            = {Marston, Rachel and Lutz, Nina and Mangabat, Danielle and S{\'a}nchez Ainsa, Gabriel and Stober, Javier and Brown, Margot and Turner, Katlyn M},
  abstract          = {This research aims to understand how frontline communities and community-based organizations (CBOs) that serve them conceptualize themselves, their communities, success, and their needs. Frontline communities experience the “first and worst” impacts of climate change due to industrialization, pollution, changing ecosystems, and other societal issues. CBOs serving frontline communities often face difficulties building organizational capacity and fostering growth in their communities. These challenges emerge from combined factors, including resistance from business and government stakeholders. Funders and scientists alike have shown interest in supporting frontline communities; however, top-down conceptualizations of success drive existing norms for intermediaries and are often inconsistent with how CBOs define success. To understand how frontline communities conceptualize themselves, success, and their needs, we conducted a mixed-methods study of CBOs within the network of an emerging intermediary organization supporting frontline communities. Using natural language processing, a survey, and semi-structured interviews, we identified themes pertaining to how frontline communities conceptualize themselves, capacity building, and success. We find that frontline communities seek four things when engaging with intermediaries: understanding of being frontline as a state of active resistance, unrestricted and destigmatized funding, technical assistance, and reciprocal relationships with resource providers. Our results suggest that self-definition of being “frontline” as active resistance impacts how frontline communities define success and therefore affects best practices for engagement. Based on this definition, we emphasize the importance of equitable relationship building and hierarchy deconstruction in the philanthropic and scientific sectors.},
  journal           = {Community Science},
  volume            = {4},
  issue             = {3},
  pages             = {e2025CSJ000133},
  year              = {2025},
  publisher         = {Wiley Online Library},
  doi               = {10.1029/2025CSJ000133},
  url               = {https://onlinelibrary.wiley.com/doi/full/10.1029/2025CSJ000133},
  altmetric         = {184859490},
  dimensions        = {true},
  selected          = {true},
  preview           = {wave-mechanics.gif},
}

@inproceedings{marston2024mixed,
  abbr              = {AGU},
  title             = {A mixed-methods systems analysis of an intergenerational intermediary organization: insights on equitable resource provision for frontline communities},
  author            = {Marston, Rachel and Lutz, Nina and Mangabat, Danielle and Sanchez-Ainsa, Gabriel and Stober, Javier and Brown, Margot and Turner, Katlyn M},
  abstract          = {Frontline communities experience the “first and worst” impacts of climate change for a variety of reasons, including proximity to industrial hazards and pollutants, proximity to delicate ecosystems, or intersecting histories of marginalization. Frontline communities can also struggle to obtain sufficient resources–like funding sources and technical assistance–to advocate for their community health and wellbeing. Many “intermediary” organizations have emerged in the United States to address these needs; however, power dynamics and historic biases can impact program efficacy. Our study aims to understand the position of the resource-providing intermediary using the Frontline Resource Institute (FRI) as a case study. By convening intergenerational, diverse views on environmental and climate justice, FRI takes an intersectional approach to supporting frontline communities. Our study aims to understand how intermediary organizations can best fulfill the resource needs of frontline communities and develop participatory structures grounded in multigenerational frontline needs. Additionally, we aim to examine how organizations aiming to support frontline communities can do so non-extractively. To achieve these aims, we used a novel mixed-methods approach combining quantitative and qualitative data collection and analysis and systems analysis to analyze FRI as an organization–including its decision-making stakeholders and processes and its inaugural grantee cohort and affiliates. Our multidisciplinary approach combined methods like natural language processing (NLP), survey instruments, semi-structured interviews, and systems architecture analysis. This systems analysis methodology facilitates understanding of how an organization like FRI functions—including its definition of success, goals, and other key motivations—and how organizational elements work together towards achieving defined standards of success. By employing a systems architecture framework, our analysis offers contextual framing for those seeking to support frontline communities–including scientists, policymakers, and resource providers–and informs philanthropic practices, resource provision for equitable climate adaptation, and participatory co-learning with frontline communities.},
  journal           = {AGU Fall Meeting Abstracts},
  volume            = {2024},
  number            = {2545},
  pages             = {SY11C--2545},
  numpages          = {0},
  year              = {2024},
  month             = {December},
  publisher         = AGU,
  url               = {https://ui.adsabs.harvard.edu/abs/2024AGUFMSY11C2545M/abstract},
  dimensions        = {true},
  google_scholar_id = {18060785815155853465}
}

